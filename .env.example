# The repository starts in deterministic fixture mode. No key is required.
AI_MODE=fixture

# Optional canonical-origin override for non-Vercel production hosting. Vercel
# supplies its production and preview origins automatically.
WEAVETRAIL_SITE_URL=

# Reserved for the server-only provider adapter. Do not expose this value with
# a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=
