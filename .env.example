# Binding configuration names for the planned server-only model-provider
# adapter. The application does not read these variables today: fixture mode is
# enforced in code, so changing them has no effect in this checkout.
AI_MODE=fixture

# The planned adapter will require all three values when AI_MODE=ai. These
# vendor-neutral names are server-only. Never create NEXT_PUBLIC_ variants.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Optional canonical-origin override for non-Vercel production hosting. Vercel
# supplies its production and preview origins automatically.
WEAVETRAIL_SITE_URL=

# Manual public-data retrieval only; never read by the application or CI.
DATA_GO_KR_SERVICE_KEY=
