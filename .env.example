# Reserved for a future provider-mode boundary and not read by the application
# today. Fixture mode is currently enforced in code, so changing this value has
# no effect.
AI_MODE=fixture

# Optional canonical-origin override for non-Vercel production hosting. Vercel
# supplies its production and preview origins automatically.
WEAVETRAIL_SITE_URL=

# Reserved for the server-only provider adapter. Do not expose this value with
# a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=

# Manual public-data retrieval only; never read by the application or CI.
DATA_GO_KR_SERVICE_KEY=
