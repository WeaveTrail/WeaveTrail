# Server-only mapping provider. Unset mode also means fixture; credentials
# alone never enable calls. Keep provider configuration unset in deployments.
AI_MODE=fixture

# The adapter requires all three values when AI_MODE=ai. These
# vendor-neutral names are server-only. Never create NEXT_PUBLIC_ variants.
# HTTPS base URL including API path, for example https://provider.invalid/v1
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Manual eval:models command only. JSON array of provider, baseUrl, model and
# apiKeyEnv (the name of a separately supplied secret variable). Use pinned
# model IDs. No default model list; never configure these in CI or deployments.
AI_EVALUATION_MODELS=

# Optional canonical-origin override for non-Vercel production hosting. Vercel
# supplies its production and preview origins automatically.
WEAVETRAIL_SITE_URL=

# Manual public-data retrieval only; never read by the application or CI.
DATA_GO_KR_SERVICE_KEY=
