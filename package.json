{
  "name": "weave-trail",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AI-assisted deterministic verification harness for heterogeneous event data",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @weavetrail/web dev",
    "build": "pnpm --filter @weavetrail/web build",
    "start": "pnpm --filter @weavetrail/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
