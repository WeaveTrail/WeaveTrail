{
  "name": "weave-trail",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AI-assisted deterministic verification harness for heterogeneous event data",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @weavetrail/web dev",
    "build": "pnpm --filter @weavetrail/web build",
    "start": "pnpm --filter @weavetrail/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "expectations:update": "vitest run packages/replay-engine/src/published-scenario-expectations.test.ts -u",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:snapshot:verify": "node scripts/verify-design-snapshot.mjs",
    "diagram:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-how-it-works-diagram.mjs",
    "diagram:case": "vitest run apps/web/src/app/case-2026-09-03/worked-case-diagram.test.ts -u",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.11"
  }
}
